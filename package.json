{
  "name": "gitfarm",
  "version": "0.1.0",
  "description": "Turn your GitHub contribution graph into a pixel-art farm with a little farmer planting your commits.",
  "type": "module",
  "bin": {
    "gitfarm": "src/cli.js"
  },
  "scripts": {
    "test": "node --test",
    "demo": "node src/cli.js --demo 7 --crop corn,sunflower,tomato --streak 100 --user octocat --out examples/demo.svg",
    "dev": "node tools/dev-server.mjs",
    "record": "node tools/record.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "playwright": "^1.48.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FelipeBeltranING/gitfarm.git"
  },
  "keywords": [
    "github",
    "profile-readme",
    "contribution-graph",
    "pixel-art",
    "github-actions",
    "svg"
  ],
  "author": "David Felipe Beltrán Tabares"
}
